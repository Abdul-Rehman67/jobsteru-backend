NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Local docker-compose defaults. Use authenticated URIs outside local development.
MONGODB_URI=mongodb://127.0.0.1:27017/jobsteru
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated browser origins. The Vite portal runs on 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

# Use long random values. Minimum 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info
BODY_LIMIT=1mb
